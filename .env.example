# ============================================================
# RootTrace Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to version control.
# ============================================================

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://roottrace:roottrace_secret@localhost:5432/roottrace
POSTGRES_DB=roottrace
POSTGRES_USER=roottrace
POSTGRES_PASSWORD=roottrace_secret

# ── Security ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_use_a_long_random_string_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── LLM Provider (Google Gemini) ─────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.1

# ── Embedding Provider ────────────────────────────────────────
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# ── GitHub (optional for MVP — local git used by default) ─────
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=roottrace-incident-lab

# ── Incident Lab ──────────────────────────────────────────────
# Path to the local git repository for the payment-api
INCIDENT_LAB_REPO_PATH=./incident-lab/payment-api

# ── LangSmith (optional observability) ───────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=roottrace

# ── Investigation Limits (cost control) ──────────────────────
MAX_TOOL_CALLS=20
MAX_HYPOTHESES=5
MAX_RETRIEVAL_RESULTS=20
MAX_INVESTIGATION_TIME_SECONDS=300
MAX_RETRIES=3
CONFIDENCE_THRESHOLD_STRONG=80
CONFIDENCE_THRESHOLD_MODERATE=60
CONFIDENCE_THRESHOLD_WEAK=40

# ── API Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_INVESTIGATE=10/minute
RATE_LIMIT_INGEST=5/minute

# ── Environment ────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ── Frontend (Next.js public env vars must be prefixed NEXT_PUBLIC_) ──
NEXT_PUBLIC_API_URL=http://localhost:8000
